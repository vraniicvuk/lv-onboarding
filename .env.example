# ===== Discord =====
DISCORD_TOKEN=
GUILD_ID=

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_AI=true
# Opcioni override sistema prompta za pregled domaćeg (ako prazno, koristi se default u main.py)
DOMACI_PROMPT=

# ===== SQLite (Render persistent disk) =====
DB_PATH=/data/onboarding.db

# ===== Kanali =====
TICKET_CATEGORY_ID=
# Kategorije u koje se ticket premešta nakon izbora nivoa
INEXPERIENCED_CATEGORY_ID=
EXPERIENCED_CATEGORY_ID=
# Kanal za "domaci" (zadatak) pregled
DOMACI_CHANNEL_ID=
# Kategorija za transcripte (/close)
TRANSCRIPT_CATEGORY_ID=

# ===== Role =====
# Smenske role (novi server ima DRUGACIJE ID-jeve)
SHIFT_GRAVEYARD_ROLE_ID=
SHIFT_AFTERNOON_ROLE_ID=
SHIFT_MAIN_ROLE_ID=
# Role koje se taguju na 6h podsetnik — ESKALACIJA (redom, 6h razmaka):
# prva na 6h -> druga na 12h -> treca na 18h
REMINDER_ROLE_IDS=1453746980525314099,1532337994726379620,1453746690342391808
# Support role (vide tickete + mogu ✅ da zaustave podsetnik)
SUPPORT_ROLE_IDS=
