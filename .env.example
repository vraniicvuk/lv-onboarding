# ===== Discord =====
DISCORD_TOKEN=
GUILD_ID=

# ===== OpenAI (ili bilo koji OpenAI-kompatibilan API: DeepSeek, OpenRouter, Groq…) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# DeepSeek primer: OPENAI_BASE_URL=https://api.deepseek.com i OPENAI_MODEL=deepseek-chat
# (prazno = koristi default OpenAI https://api.openai.com/v1)
OPENAI_BASE_URL=
USE_AI=true
# Opcioni override sistema prompta (ako prazno, koristi se default u main.py)
MASS_PROMPT=
PPV_PROMPT=

# ===== SQLite (Render persistent disk) =====
DB_PATH=/data/onboarding.db

# ===== Kanali =====
TICKET_CATEGORY_ID=
# Kategorije u koje se ticket premešta nakon izbora nivoa
INEXPERIENCED_CATEGORY_ID=
EXPERIENCED_CATEGORY_ID=
# Kategorija za transcripte (/close)
TRANSCRIPT_CATEGORY_ID=

# ===== Scheduled =====
# Kanal za dnevni shadow prijavu (10:00) i start (20:00)
SHADOW_CHANNEL_ID=
# Kategorije čiji svi kanali dobijaju regular check svaka 3 dana u 12:00 (comma-separated)
REGULAR_CHECK_CATEGORY_IDS=

# ===== Role =====
# Smenske role (ako prazno, koristi se hardkodovan default)
SHIFT_GRAVEYARD_ROLE_ID=
SHIFT_AFTERNOON_ROLE_ID=
SHIFT_MAIN_ROLE_ID=
# Role iskustva (dodeljuju se pri izboru nivoa u /ticket; ako prazno, koristi se default)
EXPERIENCED_ROLE_ID=
INEXPERIENCED_ROLE_ID=
# Role koje se taguju na 6h podsetnik — ESKALACIJA (redom, 6h razmaka):
# prva na 6h -> druga na 12h -> treca na 18h
REMINDER_ROLE_IDS=1453746980525314099,1532337994726379620,1453746690342391808
# Support role (vide tickete + mogu ✅ da zaustave podsetnik)
SUPPORT_ROLE_IDS=
